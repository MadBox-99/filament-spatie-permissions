{
    "name": "madbox-99/filament-spatie-permissions",
    "description": "Filament v5 plugin for managing Spatie roles and permissions with enum-driven sync",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "filament",
        "spatie",
        "permissions",
        "roles",
        "laravel"
    ],
    "authors": [
        {
            "name": "MadBox",
            "email": "info@madbox.hu"
        }
    ],
    "require": {
        "php": "^8.4",
        "filament/filament": "^5.0",
        "spatie/laravel-permission": "^6.0"
    },
    "require-dev": {
        "pestphp/pest": "^4.0",
        "laravel/pint": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "MadBox\\FilamentSpatiePermissions\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MadBox\\FilamentSpatiePermissions\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "MadBox\\FilamentSpatiePermissions\\FilamentSpatiePermissionsServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
