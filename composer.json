{
    "name": "madbox-99/filament-spatie-permissions",
    "description": "Filament v5 plugin for managing Spatie roles and permissions with enum-driven sync, CRUD resources, and a permission matrix overview.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "filament",
        "filament-plugin",
        "spatie",
        "laravel-permission",
        "permissions",
        "roles",
        "rbac",
        "acl",
        "laravel",
        "madbox"
    ],
    "homepage": "https://github.com/MadBox-99/filament-spatie-permissions",
    "support": {
        "issues": "https://github.com/MadBox-99/filament-spatie-permissions/issues",
        "source": "https://github.com/MadBox-99/filament-spatie-permissions"
    },
    "authors": [
        {
            "name": "MadBox",
            "email": "info@madbox.hu",
            "homepage": "https://madbox.hu"
        }
    ],
    "require": {
        "php": "^8.2",
        "filament/filament": "^5.0",
        "spatie/laravel-permission": "^6.0"
    },
    "require-dev": {
        "laravel/pint": "^1.0",
        "pestphp/pest": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "MadBox\\FilamentSpatiePermissions\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MadBox\\FilamentSpatiePermissions\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "MadBox\\FilamentSpatiePermissions\\FilamentSpatiePermissionsServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
